{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-standard.local/schemas/adr/0.2.0",
  "title": "Frontmatter de un ADR de instancia",
  "description": "docs/decisions/NNNN-<slug>.md (ficha decisions.dir, HS-ARC-005).",
  "type": "object",
  "required": ["id", "titulo", "estado", "fecha", "decisores"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "id": { "type": "string", "pattern": "^ADR-\\d{4}$" },
    "titulo": { "type": "string", "minLength": 3 },
    "estado": { "enum": ["propuesta", "aceptada", "rechazada", "reemplazada", "deprecada"] },
    "fecha": { "type": "string", "format": "date" },
    "decisores": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "reemplaza": { "type": "string", "pattern": "^ADR-\\d{4}$" },
    "reemplazada_por": { "type": "string", "pattern": "^ADR-\\d{4}$" }
  },
  "allOf": [
    { "if": { "properties": { "estado": { "const": "reemplazada" } } }, "then": { "required": ["reemplazada_por"] } }
  ]
}
