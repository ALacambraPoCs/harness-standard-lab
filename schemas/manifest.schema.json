{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-standard.local/schemas/manifest/0.1.0",
  "title": "Manifiesto de instancia del Estándar de Harness",
  "description": "Archivo .harness/manifest.yaml (ADR-004). Versión de esquema 0.1.0.",
  "type": "object",
  "required": ["standard", "project", "adapters", "commands"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "standard": {
      "type": "object",
      "required": ["version", "level"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
        "level": { "enum": ["N0", "N1", "N2", "N3"] }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "owner", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 100 },
        "owner": { "type": "string", "pattern": "^(@[A-Za-z0-9][A-Za-z0-9-]*(/[A-Za-z0-9._-]+)?|[^@\\s]+@[^@\\s]+)$", "description": "Usuario o equipo de GitHub (@org/equipo) o email." },
        "kind": { "enum": ["service", "library", "application", "infrastructure", "monorepo", "other"] },
        "docs_language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "description": "Idioma de los documentos de la instancia (Q-02)." }
      }
    },
    "adapters": {
      "type": "object",
      "required": ["agents", "platform"],
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "min_version"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["claude-code"] },
              "min_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
            }
          }
        },
        "platform": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": { "id": { "enum": ["github"] } }
        }
      }
    },
    "commands": {
      "type": "object",
      "description": "Contrato de comandos (ADR-006).",
      "required": ["setup", "check", "test"],
      "additionalProperties": false,
      "properties": {
        "setup": { "$ref": "#/$defs/command" },
        "check": { "$ref": "#/$defs/command" },
        "test":  { "$ref": "#/$defs/command" },
        "e2e":   { "$ref": "#/$defs/command" },
        "build": { "$ref": "#/$defs/command" },
        "dev":   { "$ref": "#/$defs/command" },
        "clean": { "$ref": "#/$defs/command" }
      }
    },
    "roles": {
      "type": "object",
      "description": "Solo roles reubicables cuya ruta difiere de la por defecto.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)" }
    },
    "segments": { "type": "string", "description": "Ruta del mapa de segmentos (Fase 4)." },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructions_max_lines": { "type": "integer", "minimum": 20, "maximum": 2000 },
        "instructions_max_constraints": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Máximo de restricciones duras en AGENTS.md raíz (HS-CTX-002; 15 por defecto)." }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "reason", "approved_by", "approved_on", "expires"],
        "additionalProperties": false,
        "properties": {
          "requirement": { "type": "string", "pattern": "^HS-[A-Z]{2,3}-\\d{3}$" },
          "reason": { "type": "string", "minLength": 10 },
          "approved_by": { "type": "string", "minLength": 2 },
          "approved_on": { "type": "string", "format": "date" },
          "expires": { "type": "string", "format": "date" }
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ciclo de vida de tareas (N1, ADR-005/ADR-016, D-023).",
      "properties": {
        "trivial_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Patrones (sintaxis CODEOWNERS) que un PR 'trivial' puede tocar. Sustituye a la lista por defecto." },
        "acceptance_timeout": { "type": "integer", "minimum": 10, "maximum": 3600, "description": "Segundos por criterio de aceptación en CI (600 por defecto)." }
      }
    },
    "plataforma": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lo que comprueba `harness platform check` (F5.3-A, HS-CI-006).",
      "properties": {
        "checks_requeridos": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Nombres de job de los checks requeridos; sustituye a los del nivel." },
        "entorno_puerta": { "type": "string", "minLength": 1, "description": "Environment de la puerta de riesgo alto (por defecto aprobacion-riesgo-alto)." },
        "entorno_despliegue": { "type": "string", "minLength": 1, "description": "Environment de despliegue a producción (F5.6)." }
      }
    },
    "riesgo": {
      "type": "object",
      "additionalProperties": false,
      "description": "Clase de riesgo calculada (D-058, HS-CI-005).",
      "properties": {
        "rutas_criticas": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Patrones (sintaxis CODEOWNERS) que se AÑADEN a las rutas críticas del estándar (despliegue, infraestructura, migraciones…). No se pueden quitar las del estándar." }
      }
    }
  },
  "$defs": {
    "command": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
