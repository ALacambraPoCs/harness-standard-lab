{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-standard.local/schemas/requirements/0.1.0",
  "title": "Registro de requisitos del Estándar de Harness",
  "description": "standard/requirements.yaml (ADR-002).",
  "type": "object",
  "required": ["version_estandar", "niveles_definidos", "requisitos"],
  "additionalProperties": false,
  "properties": {
    "version_estandar": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "niveles_definidos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["N0", "N1", "N2", "N3"] } },
    "niveles_desde": {
      "description": "Versión del estándar desde la que existe cada nivel (D-029). Por defecto, 0.1.0.",
      "type": "object",
      "propertyNames": { "enum": ["N0", "N1", "N2", "N3"] },
      "additionalProperties": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
    },
    "requisitos": { "type": "array", "items": { "$ref": "#/$defs/requisito" } }
  },
  "$defs": {
    "requisito": {
      "type": "object",
      "required": ["id", "titulo", "texto", "nivel", "ambito", "conformidad", "naturaleza", "verificacion", "exentable", "reglas", "fuentes", "estado", "desde", "retirada"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^HS-(INS|ARC|STA|VER|CON|SEC|CTX|CMP|CI|OBS|GOV)-\\d{3}$" },
        "titulo": { "type": "string", "minLength": 5 },
        "texto": { "type": "string", "pattern": "(DEBE|DEBERÍA|PUEDE)" },
        "nivel": { "enum": ["DEBE", "NO DEBE", "DEBERÍA", "NO DEBERÍA", "PUEDE"] },
        "ambito": { "enum": ["instancia", "estandar"] },
        "adaptador": { "type": "string" },
        "conformidad": { "type": "array", "uniqueItems": true, "items": { "enum": ["N0", "N1", "N2", "N3"] } },
        "naturaleza": { "enum": ["guidance", "enforcement"] },
        "verificacion": { "enum": ["automatica", "semiautomatica", "manual"] },
        "verificacion_manual": { "type": "string" },
        "exentable": { "type": "boolean" },
        "reglas": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$" } },
        "fuentes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "nota": { "type": "string" },
        "estado": { "enum": ["propuesto", "aprobado", "deprecado", "retirado"] },
        "desde": { "type": "string" },
        "retirada": { "type": "string", "minLength": 3 }
      },
      "allOf": [
        { "if": { "properties": { "verificacion": { "const": "automatica" } } },
          "then": { "properties": { "reglas": { "minItems": 1 } } } },
        { "if": { "properties": { "verificacion": { "enum": ["semiautomatica", "manual"] } } },
          "then": { "required": ["verificacion_manual"] } },
        { "if": { "properties": { "ambito": { "const": "instancia" } } },
          "then": { "properties": { "conformidad": { "minItems": 1 } } } }
      ]
    }
  }
}
