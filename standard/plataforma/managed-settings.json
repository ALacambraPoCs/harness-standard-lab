{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)",
      "Bash(gh repo delete *)"
    ],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [],
      "allowManagedDomainsOnly": true
    },
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/gh", "~/.config/harness"]
    }
  }
}
